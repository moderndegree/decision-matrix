                  "version": 2
                },
                "conditions": [
                  {
                    "id": "a1090000-0000-4000-8000-0000000c0003",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "keep",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "keep"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
