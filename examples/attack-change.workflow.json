      "id": "a1030000-0000-4000-8000-000000000008",
      "name": "Ask a person",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1420,
        680
      ]
    },
    {
      "parameters": {
        "state": "={{ JSON.stringify($('Build state').item.json.state) }}",
        "questionSet": "custom",
        "questions": {
          "change_type": {
            "type": "choice",
            "instructions": "What kind of change this is, based on the facts in the state",
            "criteria": {
              "feature": "New behavior or a structural change",
              "bugfix": "Correct broken behavior",
              "refactor": "Restructure without a behavior change",
              "docs": "Documentation only",
              "chore": "Tooling or maintenance"
            }
          },
          "delivery_risk": {
            "type": "score",
            "instructions": "How wide the blast radius is if this change ships",
            "criteria": [
              "One line or docs",
              "One service, easy to reverse",
              "Shared data or a migration",
              "Hard to reverse or customer-facing"
            ]
          },
          "needs_design": {
            "type": "noul",
            "instructions": "A design review should happen before implementation"
          },
          "ready_to_implement": {
            "type": "noul",
            "instructions": "The change is specific enough to implement"
          }
        },
        "rules": {
          "version": 1,
          "default_action": {
            "type": "escalate",
            "target": "human",
            "reason": "No matching rule",
            "gate": true
          },
          "thresholds": {
            "high_confidence": 0.85,
            "medium_confidence": 0.7,
            "wide_blast": 2
          },
          "rules": [
            {
              "id": "needs-design",
              "description": "Unclear or wide work waits for design",
              "when": {
                "any": [
                  {
                    "question": "needs_design",
                    "gte": "medium_confidence"
                  },
                  {
                    "question": "delivery_risk",
                    "gte": "wide_blast"
                  },
                  {
                    "question": "ready_to_implement",
                    "lt": 0.4
                  }
                ]
              },
              "action": {
                "type": "review",
                "target": "design",
                "reason": "Change needs design review before implementation",
                "gate": true
              }
            },
            {
              "id": "ready-implementer",
              "description": "Specific, narrow work can merge",
              "when": {
                "all": [
                  {
                    "question": "ready_to_implement",
                    "gte": "high_confidence"
                  },
                  {
                    "question": "delivery_risk",
                    "lt": "wide_blast"
                  },
                  {
                    "question": "change_type",
                    "in": [
                      "feature",
                      "bugfix",
                      "refactor",
                      "docs",
                      "chore"
                    ],
                    "confidence_gte": "medium_confidence"
                  }
                ]
              },
              "action": {
                "type": "route",
                "target": "implementer",
                "reason": "Ready to implement as {{answers.change_type.choice}}",
                "gate": false
              }
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "includeFullAnswers": true,
          "failOnNoMatch": false
        }
      },
