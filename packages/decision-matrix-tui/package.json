    "decision-matrix-systemone": "workspace:^",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "bun": "1.4.4",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
