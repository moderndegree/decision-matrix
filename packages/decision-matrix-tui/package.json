  "description": "Terminal editor and test bench for decision-matrix policies. Runs on Bun.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "decision-matrix-tui": "./src/main.tsx"
  },
  "scripts": {
