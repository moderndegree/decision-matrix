{
  "name": "decision-matrix-cli",
  "version": "0.1.0",
  "description": "Local command that classifies one event with a System One server and a first-match ruleset.",
  "license": "MIT",
  "bin": {
    "decision-matrix": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "decision-matrix-rules": "0.1.0",
    "decision-matrix-systemone": "0.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
