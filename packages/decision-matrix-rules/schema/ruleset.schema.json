{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-matrix-rules/schema/ruleset.schema.json",
  "title": "Decision matrix ruleset",
  "description": "Version 1 first-match policy over normalized System One answers and host-verified facts. The TypeScript parser in decision-matrix-rules is the reference implementation. It rejects unknown keys, mixed choice and numeric operators on one question predicate, threshold names that do not resolve, and, under open_gate_requires_facts, any rule that model answers alone could use to open the gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "default_action",
    "rules"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "thresholds": {
      "$ref": "#/$defs/thresholds"
    },
    "default_action": {
      "$ref": "#/$defs/action"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "open_gate_requires_facts": {
      "type": "boolean",
      "description": "When true, default_action.gate must be true, and every rule with gate false must require a fact predicate on every path through its when (a fact under all, or under every branch of any). Model answers can then only hold."
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      }
    },
    "operand": {
      "description": "A finite number, a threshold name, {{thresholds.name}}, or {\"threshold\":\"name\"}.",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "threshold"
          ],
          "properties": {
            "threshold": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target",
        "reason"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "boolean"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "when",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "description": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "$ref": "#/$defs/predicate"
        },
        {
          "$ref": "#/$defs/factPredicate"
        }
      ]
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "eq": {
          "type": [
            "string",
            "number"
          ]
        },
        "neq": {
          "type": [
            "string",
            "number"
          ]
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "not_in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "gte": {
          "$ref": "#/$defs/operand"
        },
        "gt": {
          "$ref": "#/$defs/operand"
        },
        "lte": {
          "$ref": "#/$defs/operand"
        },
        "lt": {
          "$ref": "#/$defs/operand"
        },
        "confidence_gte": {
          "$ref": "#/$defs/operand"
        },
        "confidence_lt": {
          "$ref": "#/$defs/operand"
        }
      }
    },
    "answerView": {
      "title": "Normalized answer",
      "description": "The shape evaluateRules reads. decision-matrix-systemone produces it from a server response. Another host can produce the same shape from its own client.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "choice",
            "noul",
            "score"
          ]
        },
        "choice": {
          "type": "string"
        },
        "noul": {
          "type": "number"
        },
        "score": {
          "type": "number"
        },
        "confidence": {
          "type": "number"
        },
        "probabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "factValue": {
      "description": "A literal compared strictly. A string is never a threshold name here.",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "factPredicate": {
      "description": "Reads a value the host verified, passed to evaluateRules separately from the answers and never sent to the server. A missing fact, or a value of the wrong type for the operator, is an evaluation error rather than false. eq, neq, in, and not_in need a scalar fact whose type matches an operand (or null). contains and not_contains need an array of scalars. gte, gt, lte, and lt need a finite number.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact"
      ],
      "properties": {
        "fact": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$"
        },
        "eq": {
          "$ref": "#/$defs/factValue"
        },
        "neq": {
          "$ref": "#/$defs/factValue"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/factValue"
          }
        },
        "not_in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/factValue"
          }
        },
        "contains": {
          "$ref": "#/$defs/factValue"
        },
        "not_contains": {
          "$ref": "#/$defs/factValue"
        },
        "gte": {
          "$ref": "#/$defs/operand"
        },
        "gt": {
          "$ref": "#/$defs/operand"
        },
        "lte": {
          "$ref": "#/$defs/operand"
        },
        "lt": {
          "$ref": "#/$defs/operand"
        }
      }
    }
  }
}
